      }
    },
    {
      "type": "stat",
      "title": "Retried ops in range",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Operations that needed more than one attempt but succeeded: the failover was hidden from users.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application, kind) (round(increase(app_db_ops_total{outcome=\"retried\",application=~\"$application\"}[$__range])))",
          "legendFormat": "{{application}} {{kind}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
