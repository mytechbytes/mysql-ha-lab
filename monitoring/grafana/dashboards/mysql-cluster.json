{
  "uid": "mysql-innodb-cluster",
  "title": "MySQL InnoDB Cluster",
  "tags": [
    "mysql",
    "group-replication"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
